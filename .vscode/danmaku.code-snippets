            "spawnTrail(\"${1:#00ffff}\", ${2:200}, ${3:angle}, ${4:0}, ${5:0}, ${6:8}, ${7:0.2}, ${8:0.3}, ${9:0.5}, ${10:true}, \"${11|relative,absolute|}\", ${12:6})"
        ],
        "description": "光の尾を引くトレイル弾を生成します。引数: (color, speed, angle, offsetX, offsetY, radius, growTime, keepTime, shrinkTime, round, coordMode, hitRadius)"
    },
    "spawnBeam (極太レーザー)": {
        "prefix": ["spawnBeam", "beam"],
