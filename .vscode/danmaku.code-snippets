    "Boss Spell Template (ボススペルカード定義の雛形)": {
        "prefix": ["spellTemplate", "bossSpell"],
        "body": [
            "{",
            "    id: \"${1:spell_boss_1}\",",
            "    name: \"${2:スペル名「」}\",",
            "    hp: ${3:1200},",
            "    duration: ${4:30},",
            "    x_offset: 0,",
            "    y_offset: 0,",
            "    despawnTime: 1.5,",
            "    emitterScript: `",
            "while (true) {",
            "    aimAtTarget()",
            "    spawnRing(\"normal\", \"${5:#ff3344}\", ${6:170}, angle, ${7:16}, 0, 0, 20, \"${8|ohuda,kome,star,b_star,onmyoutama,marutama,ootama,poihuru,uroko,sword,knife,kunai1,kunai2,virus,dangan|}\", \"relative\", 6)",
            "    wait(${9:0.35})",
            "}",
            "    `,",
            "    bulletScript: `",
            "speed = ${6:170}",
            "    `,",
            "    magicCircleScript: \"\"",
            "}"
        ],
        "description": "ボススペルカードの完全な定義テンプレートを挿入します。"
    },
