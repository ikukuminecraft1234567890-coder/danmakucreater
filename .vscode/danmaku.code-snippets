            "spawnStraight(\"${1|normal,trail,laser|}\", \"${2:#ff3344}\", ${3:200}, ${4:angle}, ${5:0}, ${6:0}, ${7:20}, \"${8|ohuda,kome,star,b_star,onmyoutama,marutama,ootama,poihuru,uroko,sword,knife,kunai1,kunai2,virus,dangan,none|}\", \"${9|relative,absolute|}\", ${10:6})"
