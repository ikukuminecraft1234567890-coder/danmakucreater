    "aimAtTarget (自機狙い角度計算)": {
        "prefix": ["aimAtTarget", "aim"],
        "body": [
            "aimAtTarget()"
        ],
        "description": "ターゲット（自機）の方向へ発射角度（angle）を自動計算・設定します。"
    },
    "aimAt (指定座標狙い角度計算)": {
        "prefix": ["aimAt"],
        "body": [
            "aimAt(${1:targetX}, ${2:targetY})"
        ],
        "description": "指定したXY座標へ発射角度（angle）を計算・設定します。"
    },
    "moveTo (瞬間移動)": {
        "prefix": ["moveTo"],
        "body": [
            "moveTo(${1:0}, ${2:0})"
        ],
        "description": "発射元（ボス等）を指定の座標へ即座に移動させます。"
    },
    "slideTo (スムーズ移動)": {
        "prefix": ["slideTo"],
        "body": [
            "slideTo(${1:0}, ${2:0}, ${3:1.0})"
        ],
        "description": "発射元（ボス等）を指定の座標へ指定秒数かけて移動させます。引数: (x, y, duration)"
    },
    "wait (待機)": {
        "prefix": ["wait"],
        "body": [
            "wait(${1:0.2})"
        ],
        "description": "指定秒数だけ処理を待機します。"
    },
    "repeat (指定回数ループ)": {
        "prefix": ["repeat"],
        "body": [
            "repeat(${1:10}) {",
            "    $0",
            "}"
        ],
        "description": "指定した回数だけ処理を繰り返します。"
    },
    "while true (無限ループ)": {
        "prefix": ["while true", "while", "loop"],
        "body": [
            "while (true) {",
            "    $0",
            "}"
        ],
        "description": "弾幕のメイン発射ループを作成します。"
    },
    "for loop (インデックス付きループ)": {
        "prefix": ["for", "forloop"],
        "body": [
            "for (let ${1:i} = 0; ${1:i} < ${2:10}; ${1:i}++) {",
            "    $0",
            "}"
        ],
        "description": "インデックス変数付きの繰り返し処理を作成します。"
    },
    "tween (変数アニメーション・イージング)": {
        "prefix": ["tween"],
        "body": [
            "tween(\"${1|angle,speed,x_offset,y_offset,radius,scale|}\", ${2:0}, ${3:360}, \"${4|seconds,frames,step,vecstep|}\", ${5:1.0}, \"${6|linear,easeIn,easeOut,easeInOut|}\")"
        ],
        "description": "指定した変数を時間をかけて滑らかに変化させます。"
    },
    "tweenWait (完了待機付き変数アニメーション)": {
        "prefix": ["tweenWait"],
        "body": [
            "tweenWait(\"${1|angle,speed,x_offset,y_offset,radius,scale|}\", ${2:0}, ${3:360}, \"${4|seconds,frames,step,vecstep|}\", ${5:1.0}, \"${6|linear,easeIn,easeOut,easeInOut|}\")"
        ],
        "description": "変数の変化が完了するまで待機する tween 処理を行います。"
    },
    "tweenAngle (角度アニメーション)": {
        "prefix": ["tweenAngle"],
        "body": [
            "tweenAngle(${1:0}, ${2:360}, \"${3|seconds,frames|}\", ${4:1.0}, \"${5|linear,easeIn,easeOut,easeInOut|}\")"
        ],
        "description": "発射角度（angle）を時間をかけて滑らかに回転させます。"
    },
