{
    "spawnRing (全方位弾・リング弾)": {
        "prefix": ["spawnRing", "ring"],
        "body": [
            "spawnRing(\"${1|normal,trail,laser|}\", \"${2:#ff3344}\", ${3:170}, ${4:angle}, ${5:16}, ${6:0}, ${7:0}, ${8:20}, \"${9|ohuda,kome,star,b_star,onmyoutama,marutama,ootama,poihuru,uroko,sword,knife,kunai1,kunai2,virus,dangan,none|}\", \"${10|relative,absolute|}\", ${11:6})"
        ],
        "description": "全方位リング弾を生成します。引数: (bulletType, color, speed, angle, count, offsetX, offsetY, radius, bulletImage, coordMode, hitRadius)"
    },
    "spawnWay (Way弾・扇状弾)": {
        "prefix": ["spawnWay", "way"],
        "body": [
            "spawnWay(\"${1|normal,trail,laser|}\", \"${2:#ff3344}\", ${3:180}, ${4:angle}, ${5:3}, ${6:30}, ${7:0}, ${8:0}, ${9:20}, \"${10|ohuda,kome,star,b_star,onmyoutama,marutama,ootama,poihuru,uroko,sword,knife,kunai1,kunai2,virus,dangan,none|}\", \"${11|relative,absolute|}\", ${12:6})"
        ],
        "description": "扇状（Way）に弾を生成します。引数: (bulletType, color, speed, angle, count, spread, offsetX, offsetY, radius, bulletImage, coordMode, hitRadius)"
    },
    "spawnStraight / spawnBullet (単発弾)": {
        "prefix": ["spawnStraight", "spawnBullet", "straight"],
